# ============================================================
# templates/nginx.conf.j2 — Nginx Config (Jinja2 Template)
# TOPIC COVERED: Jinja2 templates, filters, conditionals, loops
#
# Jinja2 Syntax:
#   {{ variable }}        — output a variable
#   {% if ... %}          — conditional
#   {% for ... %}         — loop
#   {{ var | filter }}    — apply a filter to variable
# ============================================================

# Auto-generated by Ansible on {{ ansible_date_time.date }}
# Managed node: {{ inventory_hostname }}
# Environment:  {{ env | upper }}     {# Jinja2 filter: upper case #}
# DO NOT EDIT MANUALLY — changes will be overwritten!

# ── Worker settings ──────────────────────────────────────────
worker_processes {{ nginx_worker_processes }};
pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections }};
    multi_accept on;
    use epoll;
}

http {
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout }};
    client_max_body_size {{ nginx_client_max_body_size }};
    server_tokens off;   # hide nginx version (security!)

    # Logging
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # MIME types
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # ── Upstream Backend Pool ─────────────────────────────────
    # JINJA2 LOOP: iterate over upstream_servers list
    upstream {{ app_name }}_backend {
        {{ nginx_lb_method }};   # least_conn / ip_hash / (empty = round_robin)

        {% for server in upstream_servers %}
        server {{ server }} max_fails=3 fail_timeout=30s;
        {% endfor %}

        # Health check keepalive
        keepalive 32;
    }

    # ── Main Server Block ─────────────────────────────────────
    server {
        listen {{ nginx_port }} default_server;
        server_name {{ ansible_hostname }} {{ ansible_default_ipv4.address }};

        # ── JINJA2 CONDITIONAL: production vs non-production ──
        {% if env == 'production' %}
        # Production: strict timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        {% else %}
        # Non-production: relaxed timeouts for debugging
        proxy_connect_timeout 30s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
        {% endif %}

        # ── Main app proxy ────────────────────────────────────
        location / {
            proxy_pass         http://{{ app_name }}_backend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection keep-alive;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # ── Health check endpoint ─────────────────────────────
        location /health {
            access_log off;
            add_header Content-Type text/plain;
            return 200 'healthy\n';
        }

        # ── Nginx status page (only on primary LB) ────────────
        {% if is_primary_lb is defined and is_primary_lb %}
        location /nginx_status {
            stub_status on;
            access_log  off;
            allow 127.0.0.1;
            allow 172.31.0.0/16;   # VPC CIDR
            deny  all;
        }
        {% endif %}

        # ── Security headers ─────────────────────────────────
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;

        # ── Custom error pages ───────────────────────────────
        error_page 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
