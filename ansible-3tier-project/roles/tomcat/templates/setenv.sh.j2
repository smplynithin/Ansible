#!/bin/bash
# Generated by Ansible — do not edit manually
# TOPIC: Jinja2 template with variables + filters

export JAVA_HOME="{{ java_home }}"
export CATALINA_HOME="{{ tomcat_home }}"
export CATALINA_PID="{{ tomcat_home }}/tomcat.pid"

# JVM Memory Settings (from group_vars/appservers.yml)
export JAVA_OPTS="
  -Xms{{ jvm_heap_min }}
  -Xmx{{ jvm_heap_max }}
  {{ jvm_gc_opts }}
  -Djava.awt.headless=true
  -Dfile.encoding=UTF-8
  -Djava.net.preferIPv4Stack=true
"

# App-specific system properties
export CATALINA_OPTS="
  -Dapp.name={{ app_name }}
  -Dapp.version={{ app_version }}
  -Dapp.env={{ env }}
  -Ddb.host={{ db_host }}
  -Ddb.name={{ db_name }}
  -Ddb.user={{ db_user }}
  -Ddb.password={{ db_password }}
"
