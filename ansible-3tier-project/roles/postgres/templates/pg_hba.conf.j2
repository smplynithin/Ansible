# ============================================================
# pg_hba.conf — PostgreSQL Client Authentication
# Generated by Ansible on {{ ansible_date_time.date }}
# TOPIC: Jinja2 for loop over postgres_allowed_hosts list
# ============================================================

# TYPE  DATABASE   USER         ADDRESS               METHOD

# Local unix socket connections
local   all        postgres                            peer
local   all        all                                 md5

# IPv4 loopback
host    all        all          127.0.0.1/32           md5

# Allow app servers to connect
# JINJA2 LOOP: iterate over list from group_vars/dbservers.yml
{% for host_cidr in postgres_allowed_hosts %}
host    {{ db_name }}   {{ db_user }}   {{ host_cidr }}   md5
{% endfor %}

# Monitoring user (read-only)
{% for host_cidr in postgres_allowed_hosts %}
host    {{ db_name }}   monitoring   {{ host_cidr }}   md5
{% endfor %}

# Deny everything else
host    all        all          0.0.0.0/0              reject
