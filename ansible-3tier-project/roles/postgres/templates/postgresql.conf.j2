# ============================================================
# postgresql.conf — Performance Configuration
# Generated by Ansible on {{ ansible_date_time.date }}
# TOPIC: Jinja2 with variables from group_vars/dbservers.yml
# ============================================================

# Connection Settings
listen_addresses = 'localhost,{{ ansible_default_ipv4.address }}'
port = {{ postgres_port }}
max_connections = {{ postgres_max_connections }}

# Memory Settings
shared_buffers = {{ postgres_shared_buffers }}
effective_cache_size = {{ postgres_effective_cache_size }}
work_mem = {{ postgres_work_mem }}
maintenance_work_mem = 64MB

# WAL Settings (Write-Ahead Log — important for durability)
wal_level = replica
max_wal_senders = 3
wal_keep_size = 256

# Logging
log_destination = 'stderr'
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_rotation_age = 1d
log_min_duration_statement = 1000   # log queries > 1 second
log_line_prefix = '%t [%p]: [%l-1] user=%u,db=%d,app=%a,client=%h '

# Performance
checkpoint_completion_target = 0.9
random_page_cost = 1.1   # SSD optimized (use 4.0 for HDD)
effective_io_concurrency = 200

# Auto-vacuum tuning
autovacuum = on
autovacuum_max_workers = 3
autovacuum_naptime = 1min
